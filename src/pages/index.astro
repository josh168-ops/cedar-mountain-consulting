---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const page = await getEntry('pages', 'home');
const { Content } = await render(page);
---

<Layout title="Cedar Mountain Consulting" description={page.data.description}>

  <section class="relative overflow-hidden bg-[#102b15]">
    <div class="absolute inset-0">
      <img src="/images/hero-mountain.jpg" alt="Mountain landscape" class="h-full w-full object-cover opacity-70" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,43,21,0.82),rgba(16,43,21,0.62),rgba(16,43,21,0.4))]"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div>
        <div>
          <h1 class="max-w-[720px] py-1 text-4xl font-bold leading-[1.2] tracking-tight text-white md:text-5xl lg:text-6xl">
            Regulatory Compliance for Investment Advisers
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/80">
            Cedar Mountain Consulting provides tailored, outcome-driven compliance solutions for investment advisers, including private fund managers, business development companies, and multi-family offices.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/about-us" class="brand-button inline-flex items-center justify-center rounded-full border border-white/40 bg-white px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-[#102b15] transition hover:bg-cedar-100">
              About Us
            </a>
            <a href="/services" class="brand-button inline-flex items-center justify-center rounded-full border border-white/40 bg-transparent px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-white/10">
              Our Services
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-white py-20 text-[#1d2f1f]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr]">
        <div class="about-graphic overflow-hidden rounded-[30px] border border-[#dfe7df] bg-[#f4f7f4] shadow-sm">
          <img src="/images/road-mountain.jpg" alt="Mountain road" class="h-full w-full object-cover" />
        </div>

        <div>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#102b15] md:text-4xl">
            Tailored compliance strategy for firms that expect precision and practical execution.
          </h2>
          <div class="mt-6 space-y-5 text-lg leading-8 text-[#2f3f34]">
            <p>
              Cedar Mountain Consulting is a compliance consulting firm that provides tailored, outcome-driven compliance solutions for investment advisers, including private fund managers, business development companies, and multi-family offices.
            </p>
            <p>
              We combine deep regulatory expertise with practical implementation to help clients stay ahead of regulatory expectations and build enduring compliance programs.
            </p>
            <p>
              As practitioners, we understand the complex regulatory landscape and design programs that make sense for your business. Our goal is to add value by clearly distilling complex rules into practical steps that reduce risk and support your growth.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#102b15] pt-12 pb-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
      <a href="/services" class="brand-button button-fill-left mb-16 inline-flex items-center justify-center rounded-full border border-white/40 bg-transparent px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-white/10">
        Our Services
      </a>
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="section-kicker !text-[#dfeee0]">Why Cedar Mountain</p>
          <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">A disciplined approach grounded in real-world advisory experience.</h2>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="info-panel">
            <h3>Practical Guidance</h3>
            <p>We translate complex rules into operational steps that fit your business model and risk profile.</p>
          </div>
          <div class="info-panel">
            <h3>Focused Execution</h3>
            <p>We work as an extension of your team to help implement sustainable compliance processes with clarity.</p>
          </div>
          <div class="info-panel">
            <h3>Investor-Ready Programs</h3>
            <p>Our support is designed to increase confidence with board members, investors, and regulators.</p>
          </div>
          <div class="info-panel">
            <h3>Long-Term Partnership</h3>
            <p>We help build compliance programs that can evolve with your firm, its structure, and its growth plans.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <p class="section-kicker !text-cedar-700">Ready to move forward?</p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#102b15] md:text-4xl">
        Build a compliance program that supports your next phase of growth.
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="brand-button inline-flex items-center justify-center rounded-full bg-[#102b15] px-7 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#1a3822]">
          Contact Us
        </a>
        <a href="/services" class="brand-button inline-flex items-center justify-center rounded-full border border-[#102b15]/20 bg-transparent px-7 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-[#102b15] transition hover:bg-[#f1f7f1]">
          Find Out More
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const aboutGraphic = document.querySelector('.about-graphic');

  if (aboutGraphic) {
    const revealGraphic = () => aboutGraphic.classList.add('is-visible');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          revealGraphic();
          observer.disconnect();
        }
      }, { threshold: 0.2 });

      observer.observe(aboutGraphic);
    } else {
      revealGraphic();
    }
  }
</script>
