---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const page = await getEntry('pages', 'services');
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <section class="relative overflow-hidden bg-[#102b15]">
    <img src="/images/services-hero.png" alt="Cedar Mountain Consulting services" class="absolute inset-0 h-full w-full object-cover opacity-70" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,43,21,0.78),rgba(16,43,21,0.62),rgba(16,43,21,0.45))]"></div>

    <div class="relative mx-auto max-w-7xl px-6 py-20 lg:py-24">
      <div class="max-w-2xl">
        <h1 class="mt-5 text-4xl font-bold tracking-tight text-white md:text-5xl lg:text-6xl">{page.data.title}</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-white/80">
          We help investment advisers and fund managers build practical, durable compliance programs that support growth and reduce risk.
        </p>
        <a href="/contact" class="brand-button mt-8 inline-flex items-center justify-center border border-white/50 bg-white px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-[#102b15] transition hover:bg-cedar-100">
          Discuss your needs
        </a>
      </div>
    </div>
  </section>

  <section id="what-we-do" class="scroll-mt-24 bg-[#f1f7f1] py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 text-center">
        <p class="section-kicker !text-cedar-700">What We Do</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#102b15] md:text-4xl">Our Core Services</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <article class="service-card">
          <a href="#adviser-registration-and-compliance-program-setup" class="service-icon no-underline transition-colors hover:bg-cedar-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cedar-700" aria-label="01: Adviser Registration and Compliance Program Setup">01</a>
          <h3>Adviser Registration and Compliance Program Setup</h3>
          <p>Registration filings, compliance manuals, policy implementation, service-provider guidance, cybersecurity, and initial firm-wide training.</p>
          <a href="#adviser-registration-and-compliance-program-setup" class="service-card-link">Explore support <span aria-hidden="true">→</span></a>
        </article>
        <article class="service-card">
          <a href="#ongoing-compliance-support" class="service-icon no-underline transition-colors hover:bg-cedar-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cedar-700" aria-label="02: Ongoing Compliance Support">02</a>
          <h3>Ongoing Compliance Support</h3>
          <p>Annual reviews, personal-trading monitoring, training, regulatory advice, marketing-material reviews, filings, and SEC exam support.</p>
          <a href="#ongoing-compliance-support" class="service-card-link">Explore support <span aria-hidden="true">→</span></a>
        </article>
        <article class="service-card">
          <a href="#specialized-compliance-support" class="service-icon no-underline transition-colors hover:bg-cedar-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cedar-700" aria-label="03: Specialized Compliance Support">03</a>
          <h3>Specialized Compliance Support</h3>
          <p>Outsourced CCO services, NFA/CFTC compliance, mock exams, diligence, fund launches, emerging-manager support, and post-acquisition reviews.</p>
          <a href="#specialized-compliance-support" class="service-card-link">Explore support <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-18">
    <div class="mx-auto max-w-7xl px-6">
      <nav aria-label="Service offerings" class="service-nav mb-10 flex flex-wrap gap-x-7 gap-y-2 border-b border-[#dfe7df] pb-5">
        <a href="#adviser-registration-and-compliance-program-setup" class="border-b-2 border-transparent py-2 text-sm font-bold uppercase text-cedar-800 hover:border-cedar-500">
          Adviser Registration &amp; Setup
        </a>
        <a href="#ongoing-compliance-support" class="border-b-2 border-transparent py-2 text-sm font-bold uppercase text-cedar-800 hover:border-cedar-500">
          Ongoing Support
        </a>
        <a href="#specialized-compliance-support" class="border-b-2 border-transparent py-2 text-sm font-bold uppercase text-cedar-800 hover:border-cedar-500">
          Specialized Support
        </a>
      </nav>

      <div class="service-offerings prose prose-lg max-w-none text-[#233a2b] prose-headings:text-[#102b15] prose-p:text-base prose-p:leading-8 prose-li:text-base prose-li:leading-7 prose-strong:text-[#102b15]">
        <Content />
      </div>
    </div>
  </section>

  <section class="bg-[#f1f7f1] py-14 md:py-18">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-6 md:grid-cols-[0.8fr_1.2fr] md:gap-12">
      <img src="/images/services-meeting.jpg" alt="A professional presenting sales information beside a monitor in a boardroom" class="aspect-square w-full object-cover object-left" />
      <div class="py-2">
        <p class="section-kicker !text-cedar-700">Experienced leadership</p>
        <h2 class="mt-4 text-2xl font-bold text-[#102b15] md:text-3xl">Practical, senior-level guidance.</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-[#35503f]">
          We work alongside firms that need clear regulatory direction, strong operational controls, and a compliance partner who understands the realities of running a fund or adviser business.
        </p>
      </div>
    </div>
  </section>

  <div class="bg-cedar-50 border-t border-cedar-100 py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Ready to work together?</h2>
      <a href="/contact" class="bg-cedar-800 text-white font-semibold px-8 py-3 rounded hover:bg-cedar-700 transition-colors inline-block">
        Contact Us
      </a>
    </div>
  </div>
</Layout>

<style>
  .service-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: #184020;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .service-card-link:hover {
    color: #377d3b;
  }

  .service-card-link:focus-visible {
    outline: 2px solid #377d3b;
    outline-offset: 4px;
  }

  .service-nav a {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .service-nav a:focus-visible {
    outline: 2px solid #377d3b;
    outline-offset: 3px;
  }

  .service-offerings {
    display: grid;
    grid-template-columns: minmax(14rem, 0.72fr) minmax(0, 1.28fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .service-offerings :global(p:first-child) {
    grid-column: 1 / -1;
    margin: 0 0 0.5rem;
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .service-offerings :global(h2) {
    grid-column: 1;
    margin: 0;
    border-top: 0;
    border-left: 4px solid #377d3b;
    background: #f1f7f1;
    padding: 1.25rem 1.5rem;
    font-size: 1.5rem;
    line-height: 1.35;
    scroll-margin-top: 6rem;
  }

  .service-offerings :global(h2 + ul) {
    grid-column: 2;
    margin: 0;
    columns: 2;
    column-gap: 2.5rem;
  }

  .service-offerings :global(li) {
    break-inside: avoid;
    padding: 0 0 0.75rem 0.25rem;
    line-height: 1.65;
  }

  .service-offerings :global(li::marker) {
    color: #377d3b;
  }

  @media (max-width: 640px) {
    .service-offerings {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .service-offerings :global(p:first-child),
    .service-offerings :global(h2),
    .service-offerings :global(h2 + ul) {
      grid-column: 1;
    }

    .service-offerings :global(h2) {
      margin-top: 1.5rem;
    }

    .service-offerings :global(h2 + ul) {
      columns: 1;
      padding-left: 1.25rem;
    }
  }
</style>
