---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const members = (await getCollection('team')).sort(
  (a, b) => a.data.order - b.data.order
);

const portraitById: Record<string, string> = {
  '01-meher-haider': '/images/meher-harmonized.png',
  '02-larry-cowen': '/images/larry-harmonized.png',
  '03-lucy-yang': '/images/lucy-harmonized.png',
  '04-julia-braithwaite': '/images/julia-harmonized.png',
  '05-victoria-gaeta': '/images/victoria-harmonized.png',
  '06-josh-avins': '/images/josh-harmonized.png',
};

const memberEmailById: Record<string, string> = {
  '01-meher-haider': 'meher@cedarmountainconsulting.com',
  '02-larry-cowen': 'larry@cedarmountainconsulting.com',
};

const memberLinkedInById: Record<string, string> = {
  '01-meher-haider': 'https://www.linkedin.com/in/meherhaider/',
  '02-larry-cowen': 'https://www.linkedin.com/in/lawrencecowen/',
  '03-lucy-yang': 'https://www.linkedin.com/in/lucy-yang-950313/',
  '04-julia-braithwaite': 'https://www.linkedin.com/in/julia-braithwaite-b030421/',
  '05-victoria-gaeta': 'https://www.linkedin.com/in/victoria-gaeta-4482a1160/',
  '06-josh-avins': 'https://www.linkedin.com/in/josh-avins-ph-d-38306a11/',
};
---

<Layout title="Our Leadership Team" description="Meet the experienced team behind Cedar Mountain Consulting.">
  <div
    class="flex min-h-[265px] items-end bg-cover bg-center text-white"
    style="background-image: url('/images/81135788.jpg');"
    >
      <div class="mx-auto w-[680px] max-w-full pb-[61.6px]">
        <h1 class="h-[61.8px] pb-[15px] text-[35px] font-bold leading-[42px] text-white">Our Leadership Team</h1>
    </div>
  </div>

  <div class="inner-page-body">
  <div class="inner-page-content leadership-content">
    <p class="mx-auto mb-8 max-w-3xl text-center text-lg leading-8 text-[#35503f]">
      We combine our legal backgrounds with years of in-house experience to provide practical compliance solutions for our clients
    </p>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {members.map(async (member) => {
        const { Content } = await render(member);
        return (
          <article class="leadership-card">
            <button type="button" class="leadership-card-trigger" data-dialog-target={`bio-${member.id}`} aria-haspopup="dialog">
              <img
                src={portraitById[member.id]}
                alt={member.data.name}
                class="leadership-card-portrait"
              />
              <span class="leadership-card-copy">
                <span class="leadership-card-name">{member.data.name}</span>
                <span class="leadership-card-title">{member.data.title}</span>
                <span class="leadership-card-action">View bio <span aria-hidden="true">↗</span></span>
              </span>
            </button>
            <dialog id={`bio-${member.id}`} class="leadership-dialog">
              <div class="leadership-dialog-inner">
                <button type="button" class="leadership-dialog-close" data-dialog-close aria-label={`Close ${member.data.name} bio`}>×</button>
                <div class="leadership-dialog-heading">
                  <img src={portraitById[member.id]} alt="" class="leadership-dialog-portrait" />
                  <div>
                    <h2>{member.data.name}</h2>
                    <p>{member.data.title}</p>
                  </div>
                </div>
                <div class="prose prose-sm">
                  <Content />
                </div>
                {member.data.education && (
                  <p class="leadership-detail"><strong>Education:</strong> {member.data.education}</p>
                )}
                {member.data.languages && (
                  <p class="leadership-detail"><strong>Languages:</strong> {member.data.languages}</p>
                )}
                {memberLinkedInById[member.id] && (
                  <a href={memberLinkedInById[member.id]} target="_blank" rel="noreferrer" class="leadership-linkedin">
                    View {member.data.name} on LinkedIn <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </dialog>
          </article>
        );
      })}
    </div>
  </div>
  </div>
</Layout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-dialog-target]');

  triggers.forEach((trigger) => {
    const dialog = document.getElementById(trigger.dataset.dialogTarget ?? '') as HTMLDialogElement | null;
    if (!dialog) return;

    trigger.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
  });
</script>
