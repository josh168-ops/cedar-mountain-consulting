---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const page = await getEntry('pages', 'about-us');
---

<Layout title={page.data.title} description={page.data.description}>
  <div
    class="flex min-h-[265px] items-end bg-cover bg-center text-white"
    style="background-image: url('/images/81135788.jpg');"
  >
    <div class="mx-auto w-[680px] max-w-full pb-[61.6px]">
      <h1 class="h-[61.8px] pb-[15px] text-[35px] font-bold leading-[42px] text-white">{page.data.title}</h1>
    </div>
  </div>

  <div class="inner-page-body">
    <div class="inner-page-content">
      <div class="prose">
        <h2>Our Story</h2>
        <p>
          Our experience in law firms and in-house compliance showed us that firms need more than regulatory advice. We founded Cedar Mountain Consulting to pair legal and regulatory depth with practical, hands-on implementation.
        </p>
        <hr class="my-0 mb-[12.2px] border-gray-300" />
        <div class="grid grid-cols-1 gap-[30px] md:grid-cols-2">
          <div>
            <h2>Our Values</h2>
            <div class="space-y-5">
              <p><strong>Accountability:</strong> We treat your business as if it were our own, with urgency, ownership, and care.</p>
              <p><strong>Clarity Over Complexity:</strong> We translate complex regulations into clear, actionable insights.</p>
              <p><strong>High-Touch Service:</strong> We prioritize trust, responsiveness, and long-term relationships.</p>
              <p><strong>Strategic Alignment:</strong> We think beyond checklists to align compliance with your business goals.</p>
            </div>
          </div>
          <div>
            <h2>Why We Are Different</h2>
            <div class="space-y-5">
              <p><strong>Hands-On Execution:</strong> From drafting policies to preparing for an SEC exam, we help implement what we recommend.</p>
              <p><strong>Regulatory Depth:</strong> Our team brings decades of in-house and regulatory experience. We understand how regulations are applied in practice.</p>
              <p><strong>Senior-Led Support:</strong> Every client works directly with experienced senior consultants.</p>
              <p><strong>Tailored and Embedded:</strong> We go beyond templates to build compliance programs that fit your operations.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-cedar-50 border-t border-cedar-100 py-16">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Meet the team behind the work</h2>
      <a href="/our-leadership-team" class="brand-button inline-flex items-center justify-center rounded-full bg-[#102b15] px-7 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#1a3822]">
        Meet Our Team
      </a>
    </div>
  </div>
</Layout>
