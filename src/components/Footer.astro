---
const year = new Date().getFullYear();
---

<footer class="bg-cedar-800 text-white mt-16">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Brand -->
      <div>
        <p class="font-semibold text-lg mb-2">Cedar Mountain Consulting</p>
        <p class="text-cedar-200 text-sm">San Francisco · Austin</p>
      </div>

      <!-- Links -->
      <div>
        <p class="font-semibold text-sm uppercase tracking-wider mb-3 text-cedar-200">Company</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/about-us" class="text-cedar-100 hover:text-white transition-colors">About Us</a></li>
          <li><a href="/our-leadership-team" class="text-cedar-100 hover:text-white transition-colors">Our Leadership Team</a></li>
          <li><a href="/services" class="text-cedar-100 hover:text-white transition-colors">Services</a></li>
          <li><a href="/contact" class="text-cedar-100 hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Legal + Social -->
      <div>
        <p class="font-semibold text-sm uppercase tracking-wider mb-3 text-cedar-200">Legal</p>
        <ul class="space-y-2 text-sm mb-6">
          <li><a href="/privacy-policy" class="text-cedar-100 hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-of-use" class="text-cedar-100 hover:text-white transition-colors">Terms of Use</a></li>
        </ul>
        <a
          href="https://www.linkedin.com/company/cedar-mountain-consulting"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-cedar-100 hover:text-white text-sm transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>

    </div>

    <div class="border-t border-cedar-700 mt-8 pt-6 text-cedar-300 text-xs">
      ©{year} Cedar Mountain Consulting, LLC. All Rights Reserved.
    </div>
  </div>
</footer>
